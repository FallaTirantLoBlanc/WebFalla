---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { eventoNames } from "../data/eventos/names.ts";
---

<Layout title="Fiesta Halloween" description="Formulario de asistencia a la fiesta de Halloween.">
  <Navbar />

  <main>
    <section class="camo-bg">
      <div class="text-center max-w-4xl mx-auto py-24 px-4 sm:px-6">
        <div class="reveal">
          <span class="text-accent text-[10px] font-bold uppercase tracking-[0.5em] mb-4 block">Fiesta Halloween</span>
        </div>
        <div class="reveal delay-100">
          <h1 class="text-5xl sm:text-6xl md:text-7xl leading-tight mb-6">Halloween 2026</h1>
        </div>
        <div class="reveal delay-200">
          <p class="max-w-2xl mx-auto opacity-70 text-sm sm:text-base">
            Confirma tu asistencia a la fiesta de Halloween. Selecciona los nombres que correspondan y envía el formulario.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-base-200 py-20 sm:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="reveal mb-10">
          <div class="w-full max-w-full overflow-hidden rounded-3xl border border-base-300 bg-base-100 p-8 shadow-xl shadow-black/5">
            <h2 class="text-3xl mb-4">Lista de asistentes - Fiesta Halloween -</h2>

            <form
              name="fiesta-halloween"
              method="POST"
              action="/gracias/"
              netlify
              data-netlify-honeypot="bot-field"
              class="mt-6"
              id="eventos-form"
            >
              <input type="hidden" name="form-name" value="fiesta-halloween" />
              <input type="hidden" name="bot-field" />
              <input type="hidden" name="person_name" id="selected-person-name" value="" />
              <input type="hidden" name="person_status" id="selected-person-status" value="" />
              <input type="hidden" name="person_dni" id="selected-person-dni" value="" />

              <div class="grid gap-4">
                <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-lg shadow-black/5">
                  <div class="flex flex-col gap-3">
                    <div class="flex items-center justify-between gap-3">
                      <div>
                        <label for="name-filter" class="text-sm font-semibold">Busca por nombre o apellidos</label>
                        <p class="text-xs opacity-70">Filtra la lista para encontrar al participante más rápido.</p>
                      </div>
                      <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-base-200 text-base-content border border-base-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                      </span>
                    </div>
                    <input
                      id="name-filter"
                      type="search"
                      placeholder="Busca tu nombre o apellidos"
                      class="input input-bordered input-lg w-full bg-base-200 border-base-300 placeholder:text-base-content/50"
                      autocomplete="off"
                    />
                  </div>
                </div>

                <div
                  id="guest-list"
                  class="grid gap-3 max-h-[68vh] overflow-y-auto rounded-3xl border border-base-300 bg-base-100 p-4 shadow-inner shadow-black/5"
                >
                  <div class="space-y-3">
                    {eventoNames.map((item) => (
                      <div data-name={item.nombre} data-dni={item.dni} class="guest-row flex flex-col sm:flex-row items-center justify-between gap-4 rounded-xl border border-base-300 bg-base-200 p-3">
                        <div class="text-sm sm:text-base">{item.nombre}</div>
                        <div class="flex gap-2 mt-2 sm:mt-0 choice-pair" data-name={item.nombre}>
                          <button type="button" data-name={item.nombre} data-status="si" class="selectable-btn selectable-btn--yes" aria-pressed="false">Asistiré</button>
                          <button type="button" data-name={item.nombre} data-status="no" class="selectable-btn selectable-btn--no" aria-pressed="false">No asistiré</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div id="form-actions" class="mt-6 flex justify-center">
                  <div style="width:100%;max-width:420px;text-align:center">
                    <button id="submit-btn" type="submit" class="btn-primary-prominent" style="display:none;" aria-hidden="true">Enviar inscripción</button>
                    <div id="submit-message" class="mt-3" style="display:none;color:var(--color-success);font-weight:700;">Inscripción realizada</div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

<script is:inline>
  (function () {
    const selections = {};
    const MAX_SELECTIONS = 5;

    const buttons = document.querySelectorAll('.selectable-btn');
    const submitBtn = document.getElementById('submit-btn');
    const form = document.getElementById('eventos-form');
    const submitMessage = document.getElementById('submit-message');
    const filterInput = document.getElementById('name-filter');
    const hiddenNameInput = document.getElementById('selected-person-name');
    const hiddenStatusInput = document.getElementById('selected-person-status');
    const hiddenDniInput = document.getElementById('selected-person-dni');
    const nameToDni = {};

    document.querySelectorAll('.guest-row').forEach((row) => {
      const name = row.getAttribute('data-name');
      const dni = row.getAttribute('data-dni');
      if (name) nameToDni[name] = dni || '';
    });

    function updateSubmitVisibility() {
      const totalSelected = Object.keys(selections).length;
      const any = totalSelected > 0;
      if (submitBtn) {
        submitBtn.style.display = any ? 'inline-flex' : 'none';
        submitBtn.setAttribute('aria-hidden', any ? 'false' : 'true');
      }
    }

    function filterGuestList() {
      const query = filterInput?.value.trim().toLowerCase() || '';
      document.querySelectorAll('.guest-row').forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        row.style.display = query && !name.toLowerCase().includes(query) ? 'none' : '';
      });
    }

    filterInput?.addEventListener('input', () => {
      filterGuestList();
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name');
        const status = btn.getAttribute('data-status');

        if (!name || !status) return;

        if (selections[name] === status) {
          delete selections[name];
        } else {
          const totalSelected = Object.keys(selections).length;

          if (!selections[name] && totalSelected >= MAX_SELECTIONS) {
            alert(`Puedes seleccionar un máximo de ${MAX_SELECTIONS} personas.`);
            return;
          }

          selections[name] = status;
        }

        document.querySelectorAll(`button[data-name="${name}"]`).forEach((b) => {
          const matches = selections[name] && b.getAttribute('data-status') === selections[name];
          b.setAttribute('aria-pressed', matches ? 'true' : 'false');
          if (matches) {
            b.classList.add('selected');
          } else {
            b.classList.remove('selected');
          }
        });

        const pair = document.querySelector(`.choice-pair[data-name="${name}"]`);
        if (pair) {
          pair.classList.remove('selected-yes', 'selected-no');
          if (selections[name] === 'si') pair.classList.add('selected-yes');
          if (selections[name] === 'no') pair.classList.add('selected-no');
        }

        updateSubmitVisibility();
      });
    });

    form?.addEventListener('submit', (e) => {
      const namesArray = Object.keys(selections);

      if (namesArray.length === 0) {
        e.preventDefault();
        alert('Selecciona al menos una persona para enviar.');
        return;
      }

      if (namesArray.length > MAX_SELECTIONS) {
        e.preventDefault();
        alert(`Solo puedes enviar un máximo de ${MAX_SELECTIONS} personas a la vez.`);
        return;
      }

      const selectedDnis = namesArray.map((name) => nameToDni[name] || '');
      const validSelectedDnis = selectedDnis.filter((dni) => dni && dni.trim());

      if (validSelectedDnis.length > 0) {
        const confirmationDni = window.prompt(
          `Introduce el DNI de cualquiera de las personas seleccionadas con DNI registrado:\n${namesArray.join(', ')}`
        );
        if (!confirmationDni) {
          e.preventDefault();
          alert('Debes introducir un DNI para confirmar el envío.');
          return;
        }

        const normalizedEntry = confirmationDni.trim().toUpperCase().replace(/\s+/g, '');
        const validEntry = validSelectedDnis.some(
          (dni) => dni.trim().toUpperCase().replace(/\s+/g, '') === normalizedEntry
        );

        if (!validEntry) {
          e.preventDefault();
          alert('DNI incorrecto. Comprueba el DNI de uno de los seleccionados y vuelve a intentarlo.');
          return;
        }
      }

      const statusArray = namesArray.map((name) => (selections[name] === 'si' ? 'Asistiré' : 'No asistiré'));

      if (hiddenNameInput) hiddenNameInput.value = namesArray.join(', ');
      if (hiddenStatusInput) hiddenStatusInput.value = statusArray.join(', ');
      if (hiddenDniInput) hiddenDniInput.value = selectedDnis.join(', ');

      e.preventDefault();
      if (submitMessage) submitMessage.style.display = 'block';
      if (submitBtn) submitBtn.disabled = true;
      buttons.forEach((b) => (b.disabled = true));

      setTimeout(() => form.submit(), 700);
    });
  })();
</script>
</Layout>
